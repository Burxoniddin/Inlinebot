# Ushbu faylni .env nomi bilan nusxalab, qiymatlarni to'ldiring. .env ni hech qachon gitga qo'shmang.

# --- Telegram ---------------------------------------------------------------
# @BotFather dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=
# Botdan foydalana oladigan Telegram ID lar (vergul bilan). ID ni bilish uchun botga yozing — u ID ingizni aytadi.
ADMIN_IDS=

# --- Instagram (Meta Graph API) ----------------------------------------------
# Facebook Login orqali olingan uzoq muddatli token (System User tokeni tavsiya etiladi). README ga qarang.
IG_ACCESS_TOKEN=
# Instagram professional akkaunt ID si. Bo'sh qoldirilsa, token orqali avtomatik topiladi.
IG_USER_ID=
GRAPH_API_VERSION=v25.0

# --- Claude (Anthropic API) ---------------------------------------------------
# https://console.anthropic.com dan olingan kalit
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Qancha "o'ylashi": low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Xavfsizlik filtri so'rovni rad etsa, Anthropic uni avtomatik boshqa modelda qayta bajaradi
CLAUDE_FALLBACKS=true

# --- Media server ---------------------------------------------------------------
# Instagram rasm/videoni shu manzildan yuklab oladi: internetdan ochiq HTTPS manzil bo'lishi shart
# (masalan https://bot.example.com yoki cloudflared/ngrok tunnel manzili).
PUBLIC_BASE_URL=
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --- Boshqa sozlamalar ------------------------------------------------------------
TIMEZONE=Asia/Tashkent
# Instagramdagi har bir o'zgarishdan oldin ✅/❌ tugmalari bilan tasdiq so'rash (o'chirmaslik tavsiya etiladi)
REQUIRE_CONFIRMATION=true
# Brendingiz haqida: ohang, auditoriya, mahsulotlar, doimiy heshteglar... (yoki BRAND_GUIDE_FILE=brand.md)
BRAND_GUIDE=
# Shuncha soat jim turgan suhbat yangidan boshlanadi
CONVERSATION_IDLE_HOURS=12
# Yuklangan fayllar shuncha kundan keyin o'chiriladi
MEDIA_RETENTION_DAYS=14
DATA_DIR=data
LOG_LEVEL=INFO
